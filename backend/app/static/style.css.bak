:root {
  --primary: #1b5e20;
  --primary-light: #2e7d32;
  --primary-dark: #003300;
  --accent: #f57f17;
  --bg-color: #f1f8e9;
  --card-bg: #ffffff;
  --text-main: #1a231b;
  --text-muted: #556b57;
  --border-color: #dcedc8;
  --green-badge: #2e7d32;
  --red-badge: #c62828;
  --blue-badge: #1565c0;
  --radius-lg: 16px;
  --radius-md: 10px;
  --radius-sm: 6px;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.06);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Hind Siliguri', sans-serif;
  -webkit-tap-highlight-color: transparent;
}

body {
  background-color: #e8ede3;
  color: var(--text-main);
  display: flex;
  justify-content: center;
  min-height: 100vh;
}

.mobile-container {
  width: 100%;
  max-width: 480px;
  background-color: var(--bg-color);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: 0 0 25px rgba(0,0,0,0.1);
  padding-bottom: 75px;
}

/* Header */
.app-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  padding: 12px 14px 6px;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  display: flex;
  align-items: center;
  gap: 8px;
}

.logo-icon {
  font-size: 26px;
  background: rgba(255,255,255,0.2);
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.app-title {
  font-size: 20px;
  font-weight: 700;
  line-height: 1.1;
  display: flex;
  align-items: center;
  gap: 6px;
}

.ai-badge-header {
  background: #ffb300;
  color: #000;
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 10px;
  font-weight: 800;
}

.app-subtitle {
  font-size: 11px;
  opacity: 0.9;
}

.district-badge {
  display: flex;
  align-items: center;
  gap: 4px;
  background: rgba(255,255,255,0.18);
  padding: 4px 8px;
  border-radius: 20px;
  font-size: 13px;
}

.district-dropdown {
  background: transparent;
  border: none;
  color: #fff;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  outline: none;
}
.district-dropdown option {
  color: #000;
}

/* Crawler Ticker Bar */
.crawler-ticker-bar {
  background: rgba(0,0,0,0.25);
  border-radius: 6px;
  margin-top: 8px;
  padding: 4px 8px;
  font-size: 11.5px;
  display: flex;
  align-items: center;
  gap: 6px;
  overflow: hidden;
  white-space: nowrap;
}

.ticker-tag {
  color: #ffcc80;
  font-weight: 700;
  flex-shrink: 0;
}

.ticker-text {
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Main Content */
.main-content {
  padding: 12px;
  flex: 1;
}

.tab-pane {
  display: none;
}

.tab-pane.active {
  display: block;
  animation: fadeIn 0.25s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Summary Card */
.quick-summary-card {
  background: #ffffff;
  border-radius: var(--radius-md);
  padding: 12px 14px;
  border-left: 5px solid var(--accent);
  box-shadow: var(--shadow);
  margin-bottom: 12px;
}

.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.summary-title {
  font-size: 15px;
  font-weight: 700;
  color: #bf360c;
  flex: 1;
  margin-left: 6px;
}

.voice-btn-mini {
  background: #e8f5e9;
  border: 1px solid var(--primary-light);
  color: var(--primary);
  font-weight: 600;
  font-size: 12px;
  padding: 3px 8px;
  border-radius: 12px;
  cursor: pointer;
}

.summary-text {
  font-size: 13.5px;
  line-height: 1.45;
  color: #2e3d30;
  margin-bottom: 8px;
}

.bargain-tip {
  background: #fff8e1;
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  color: #795548;
}

/* Trend Chart */
.trend-chart-card {
  background: #ffffff;
  border-radius: var(--radius-md);
  padding: 12px;
  box-shadow: var(--shadow);
  margin-bottom: 12px;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.chart-header h4 {
  font-size: 13.5px;
  color: var(--text-main);
}

.trend-select {
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 6px;
  border: 1px solid #ccc;
  outline: none;
}

.svg-chart-container {
  width: 100%;
  height: 110px;
  background: #fafdf8;
  border: 1px solid #e2ede0;
  border-radius: 6px;
}

.trend-svg {
  width: 100%;
  height: 100%;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 16px;
  margin-top: 6px;
  font-size: 11.5px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 4px;
}

.legend-color {
  width: 12px;
  height: 4px;
  border-radius: 2px;
}
.legend-color.retail { background: #d32f2f; }
.legend-color.wholesale { background: #2e7d32; }

/* Search & Filters */
.search-section {
  margin-bottom: 12px;
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1px solid var(--border-color);
  border-radius: 25px;
  padding: 8px 14px;
  box-shadow: var(--shadow);
  margin-bottom: 8px;
}

.search-icon {
  font-size: 16px;
  margin-right: 8px;
  color: var(--text-muted);
}

.search-box input {
  border: none;
  width: 100%;
  font-size: 14px;
  outline: none;
  background: transparent;
}

.category-chips {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: none;
}
.category-chips::-webkit-scrollbar {
  display: none;
}

.chip {
  background: #fff;
  border: 1px solid var(--border-color);
  padding: 5px 12px;
  border-radius: 16px;
  font-size: 13px;
  white-space: nowrap;
  cursor: pointer;
  color: var(--text-main);
  transition: all 0.2s;
}

.chip.active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}

/* Commodity List Header */
.commodity-list-header {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  padding: 4px 6px 6px;
}

/* Commodity Cards */
.commodity-grid {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.commodity-card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 10px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  border: 1px solid #e0ebdb;
  transition: transform 0.1s;
}

.commodity-card:active {
  transform: scale(0.99);
}

.item-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.item-speaker-btn {
  background: #f1f8e9;
  border: 1px solid #c8e6c9;
  font-size: 16px;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-details h4 {
  font-size: 15.5px;
  font-weight: 600;
  color: var(--text-main);
}

.item-details .item-market {
  font-size: 11px;
  color: var(--text-muted);
}

.item-prices {
  text-align: right;
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 4px;
}

.price-type {
  font-size: 10.5px;
  color: var(--text-muted);
}

.price-val {
  font-size: 15px;
  font-weight: 700;
}

.price-val.wholesale {
  color: #1b5e20;
}

.price-val.retail {
  color: #37474f;
  font-size: 13px;
}

.trend-badge {
  font-size: 10.5px;
  font-weight: 600;
  padding: 1px 6px;
  border-radius: 10px;
  display: inline-block;
  margin-top: 2px;
}

.trend-badge.up {
  background: #ffebee;
  color: #c62828;
}

.trend-badge.down {
  background: #e8f5e9;
  color: #2e7d32;
}

.trend-badge.stable {
  background: #f5f5f5;
  color: #616161;
}

/* AI CONSULTANT TAB */
.consultant-hero {
  background: linear-gradient(135deg, #1565c0 0%, #0d47a1 100%);
  color: #fff;
  border-radius: var(--radius-lg);
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: var(--shadow);
}

.consultant-badge {
  display: inline-block;
  background: rgba(255,255,255,0.2);
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 12px;
  margin-bottom: 6px;
}

.consultant-hero h2 {
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 4px;
}

.consultant-hero p {
  font-size: 12.5px;
  opacity: 0.9;
}

.query-card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 12px;
  box-shadow: var(--shadow);
  margin-bottom: 12px;
}

.query-input-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #b0bec5;
  border-radius: 25px;
  padding: 6px 12px;
  background: #fafafa;
}

.query-input-wrap input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-size: 14px;
}

.btn-mic {
  background: #e3f2fd;
  border: 1px solid #90caf9;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  transition: all 0.2s;
}

.btn-mic.recording {
  background: #ffebee;
  border-color: #e57373;
  animation: pulseMic 1s infinite;
}

@keyframes pulseMic {
  0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(229, 115, 115, 0.7); }
  70% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(229, 115, 115, 0); }
  100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(229, 115, 115, 0); }
}

.quick-questions {
  margin: 10px 0;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}

.quick-lbl {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--text-muted);
}

.quick-q-chip {
  background: #f1f8e9;
  border: 1px solid #c8e6c9;
  color: #2e7d32;
  font-size: 11.5px;
  padding: 3px 8px;
  border-radius: 12px;
  cursor: pointer;
}

.btn-ask-ai {
  width: 100%;
  background: #1b5e20;
  color: #fff;
  border: none;
  padding: 10px;
  border-radius: var(--radius-md);
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

/* Consultant Response Card */
.consultant-response-card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 14px;
  box-shadow: var(--shadow);
  border-left: 5px solid #1565c0;
  margin-bottom: 14px;
}

.response-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.bot-avatar {
  background: #e3f2fd;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

.response-header h4 {
  font-size: 14.5px;
  color: #0d47a1;
}

.response-time {
  font-size: 11px;
  color: var(--text-muted);
}

.answer-main {
  font-size: 14px;
  line-height: 1.5;
  color: #1a231b;
  margin-bottom: 10px;
}

.action-steps {
  background: #f9fbe7;
  padding: 8px 12px;
  border-radius: 8px;
  margin-bottom: 8px;
}

.action-steps h5 {
  font-size: 13px;
  color: #558b2f;
  margin-bottom: 4px;
}

.action-steps ul {
  padding-left: 18px;
  font-size: 12.5px;
  line-height: 1.4;
}

.caution-box-mini {
  font-size: 12px;
  color: #c62828;
  font-weight: 500;
}

/* Crop Doctor Section */
.crop-doctor-section {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 14px;
  box-shadow: var(--shadow);
  margin-bottom: 14px;
}

.section-title-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.section-title-wrap h3 {
  font-size: 15px;
  color: var(--text-main);
}

.doctor-badge {
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 10.5px;
  padding: 2px 6px;
  border-radius: 8px;
  font-weight: 600;
}

.doctor-picker-row {
  display: flex;
  gap: 6px;
  margin-bottom: 10px;
}

.doc-select {
  border: 1px solid #ccc;
  border-radius: 6px;
  padding: 6px;
  font-size: 13px;
  outline: none;
}

.doc-symptom-input {
  flex: 1;
  border: 1px solid #ccc;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 13px;
  outline: none;
}

.btn-diagnose {
  background: #00897b;
  color: #fff;
  border: none;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
}

.diagnosis-card {
  background: #fbfdf9;
  border: 1px solid #c8e6c9;
  border-radius: 8px;
  padding: 12px;
  margin-top: 8px;
}

.diag-severity-badge {
  display: inline-block;
  background: #ffebee;
  color: #c62828;
  font-size: 10.5px;
  font-weight: 700;
  padding: 1px 6px;
  border-radius: 6px;
  margin-bottom: 4px;
}

.pathogen-txt {
  font-size: 11.5px;
  color: var(--text-muted);
  font-style: italic;
  margin-bottom: 8px;
}

.diag-block {
  margin-bottom: 8px;
  font-size: 12.5px;
  line-height: 1.4;
}

.diag-block.chemical {
  background: #fff8e1;
  padding: 6px 8px;
  border-radius: 6px;
  border-left: 3px solid #ffa000;
}

.diag-block.organic {
  background: #e8f5e9;
  padding: 6px 8px;
  border-radius: 6px;
  border-left: 3px solid #43a047;
}

/* Negotiation Calculator */
.negotiation-calculator-section {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 14px;
  box-shadow: var(--shadow);
  margin-bottom: 14px;
}

.negotiation-calculator-section h3 {
  font-size: 15px;
  color: #e65100;
}

.calc-sub {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 10px;
}

.calc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 10px;
}

.calc-grid .form-group {
  margin-bottom: 0;
}
.calc-grid label {
  font-size: 11.5px;
  margin-bottom: 2px;
}
.calc-grid input {
  padding: 6px 8px;
  font-size: 13px;
}

.btn-calc-deal {
  width: 100%;
  background: #e65100;
  color: #fff;
  border: none;
  padding: 10px;
  border-radius: var(--radius-md);
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
}

.calc-result-box {
  background: #fff8e1;
  border: 1px solid #ffe082;
  border-radius: 8px;
  padding: 12px;
  margin-top: 10px;
}

.result-stats-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}

.stat-pill {
  font-size: 12px;
}
.text-green { color: #2e7d32; }

.deal-evaluation {
  font-size: 12.5px;
  font-weight: 600;
  color: #d32f2f;
  margin-bottom: 8px;
}

.negotiation-script-box {
  background: #fff;
  border: 1px solid #ffd54f;
  padding: 8px 10px;
  border-radius: 6px;
}

.negotiation-script-box h5 {
  font-size: 12px;
  color: #b26a00;
  margin-bottom: 4px;
}

.negotiation-script-box p {
  font-size: 12.5px;
  line-height: 1.45;
  color: #3e2723;
  margin-bottom: 6px;
}

/* Weather & Advisory Tab */
.weather-hero-card {
  background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
  color: #fff;
  border-radius: var(--radius-lg);
  padding: 16px;
  box-shadow: 0 4px 15px rgba(27, 94, 32, 0.25);
  margin-bottom: 14px;
}

.weather-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.weather-date {
  font-size: 12px;
  opacity: 0.85;
}

.weather-cond {
  font-size: 15px;
  margin-top: 4px;
  font-weight: 500;
}

.weather-temp-box {
  display: flex;
  align-items: flex-start;
}

.temp-big {
  font-size: 44px;
  font-weight: 700;
  line-height: 1;
}

.temp-unit {
  font-size: 18px;
  margin-top: 4px;
}

.weather-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 14px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-md);
  padding: 10px 12px;
}

.stat-item {
  text-align: center;
}

.stat-icon {
  font-size: 16px;
  display: block;
}

.stat-val {
  font-size: 14px;
  font-weight: 600;
  display: block;
}

.stat-lbl {
  font-size: 10px;
  opacity: 0.85;
}

.audio-listen-bar {
  margin-top: 12px;
}

.btn-voice-large {
  width: 100%;
  background: #ffb300;
  color: #212121;
  border: none;
  padding: 10px 14px;
  border-radius: 25px;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  box-shadow: 0 3px 8px rgba(0,0,0,0.15);
  transition: transform 0.1s;
}

.btn-voice-large:active {
  transform: scale(0.98);
}

/* Advisory Card */
.advisory-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 14px;
  box-shadow: var(--shadow);
  margin-bottom: 14px;
}

.advisory-header {
  margin-bottom: 12px;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 8px;
}

.ai-badge {
  display: inline-block;
  background: #e3f2fd;
  color: #0d47a1;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 12px;
  margin-bottom: 4px;
}

.advisory-header h3 {
  font-size: 16px;
  color: #c62828;
}

.action-box {
  margin-bottom: 10px;
  padding: 10px 12px;
  border-radius: var(--radius-md);
}

.action-box h4 {
  font-size: 13.5px;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.badge-icon {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: #fff;
}
.badge-icon.green { background: #2e7d32; }
.badge-icon.red { background: #c62828; }
.badge-icon.blue { background: #1565c0; }

.action-box ul {
  padding-left: 20px;
  font-size: 13px;
  line-height: 1.45;
}

.action-box.dos-box {
  background: #f1f8e9;
  border: 1px solid #c8e6c9;
}

.action-box.donts-box {
  background: #ffebee;
  border: 1px solid #ffcdd2;
}

.action-box.irrig-box {
  background: #e1f5fe;
  border: 1px solid #b3e5fc;
  font-size: 13px;
}

/* Forecast strip */
.forecast-strip-section {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 12px;
  box-shadow: var(--shadow);
}

.forecast-strip-section h3 {
  font-size: 14px;
  margin-bottom: 8px;
  color: var(--text-main);
}

.forecast-scroll {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 4px;
}

.forecast-day-card {
  flex: 0 0 75px;
  background: #f9fbf7;
  border: 1px solid #e0ebdb;
  border-radius: var(--radius-sm);
  padding: 8px 4px;
  text-align: center;
  font-size: 11px;
}

.forecast-day-card .day-name {
  font-weight: 600;
  display: block;
}

.forecast-day-card .day-icon {
  font-size: 20px;
  margin: 4px 0;
  display: block;
}

.forecast-day-card .day-temp {
  font-weight: 700;
  color: #2e7d32;
}

/* Profile Tab */
.profile-card, .admin-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 16px;
  box-shadow: var(--shadow);
}

.profile-desc {
  font-size: 12.5px;
  color: var(--text-muted);
  margin-bottom: 14px;
}

.form-group {
  margin-bottom: 12px;
}

.form-group label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 4px;
  color: var(--text-main);
}

.form-group input, .form-group textarea, .form-group select {
  width: 100%;
  padding: 8px 10px;
  border: 1px solid #ccc;
  border-radius: var(--radius-sm);
  font-size: 14px;
  outline: none;
}

.form-row {
  display: flex;
  gap: 8px;
}
.form-group.half {
  flex: 1;
}

.crop-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 4px;
}

.crop-tag {
  background: #f5f5f5;
  border: 1px solid #ddd;
  padding: 5px 10px;
  border-radius: 16px;
  font-size: 12.5px;
  cursor: pointer;
  user-select: none;
}

.crop-tag.active {
  background: #e8f5e9;
  border-color: #2e7d32;
  color: #1b5e20;
  font-weight: 600;
}

.checkbox-group label {
  font-size: 12.5px;
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.btn-save-profile, .btn-admin-action {
  width: 100%;
  background: var(--primary);
  color: #fff;
  border: none;
  padding: 10px;
  border-radius: var(--radius-md);
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
}

.btn-admin-action.warning {
  background: #c62828;
}

.save-status, .action-result {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  font-weight: 600;
  color: #2e7d32;
  text-align: center;
}

/* Admin */
.admin-actions {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-top: 12px;
}

.action-card {
  border: 1px solid var(--border-color);
  padding: 12px;
  border-radius: var(--radius-md);
  background: #fbfdf9;
}

.action-card h3 {
  font-size: 14.5px;
  margin-bottom: 4px;
}

.action-card p {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 8px;
}

.stats-card {
  background: #e8f5e9;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  font-size: 12.5px;
}

/* Bottom Navigation */
.bottom-nav {
  position: fixed;
  bottom: 0;
  width: 100%;
  max-width: 480px;
  background: #ffffff;
  border-top: 1px solid #dcedc8;
  display: flex;
  justify-content: space-around;
  padding: 6px 0;
  z-index: 100;
}

.nav-item {
  background: none;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #607d8b;
  cursor: pointer;
  flex: 1;
  padding: 4px 0;
}

.nav-icon {
  font-size: 20px;
}

.nav-text {
  font-size: 11px;
  font-weight: 500;
  margin-top: 2px;
}

.nav-item.active {
  color: var(--primary);
  font-weight: 700;
}

.loading-spinner {
  text-align: center;
  padding: 24px;
  color: var(--text-muted);
  font-size: 14px;
}

/* ===================================================
   DARK MODE STYLES & TOGGLE
   =================================================== */

.header-actions {
  display: flex;
  align-items: center;
  gap: 6px;
}

.theme-toggle-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.35);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  color: #fff;
  transition: all 0.2s ease;
  user-select: none;
}

.theme-toggle-btn:hover {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(1.08);
}

body.dark-mode {
  --primary: #2e7d32;
  --primary-light: #388e3c;
  --primary-dark: #1b5e20;
  --accent: #ffb74d;
  --bg-color: #0d140e;
  --card-bg: #152017;
  --text-main: #e8f5e9;
  --text-muted: #8fae92;
  --border-color: #243527;
  --shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
  background-color: #080c09;
  color: #e8f5e9;
}

body.dark-mode .mobile-container {
  background-color: var(--bg-color);
  box-shadow: 0 0 30px rgba(0,0,0,0.6);
}

body.dark-mode .app-header {
  background: linear-gradient(135deg, #0d3813 0%, #154c1c 100%);
  border-bottom: 1px solid #1f3f24;
}

body.dark-mode .quick-summary-card,
body.dark-mode .trend-chart-card,
body.dark-mode .commodity-card,
body.dark-mode .query-card,
body.dark-mode .consultant-response-card,
body.dark-mode .crop-doctor-section,
body.dark-mode .negotiation-calculator-section,
body.dark-mode .advisory-card,
body.dark-mode .forecast-strip-section,
body.dark-mode .profile-card,
body.dark-mode .admin-card,
body.dark-mode .action-card {
  background: var(--card-bg);
  border-color: var(--border-color);
  color: var(--text-main);
}

body.dark-mode .summary-text,
body.dark-mode .item-details h4,
body.dark-mode .answer-main,
body.dark-mode .section-title-wrap h3,
body.dark-mode .forecast-strip-section h3,
body.dark-mode .form-group label {
  color: #e8f5e9;
}

body.dark-mode .search-box,
body.dark-mode .query-input-wrap,
body.dark-mode .form-group input,
body.dark-mode .form-group textarea,
body.dark-mode .form-group select,
body.dark-mode .doc-select,
body.dark-mode .doc-symptom-input,
body.dark-mode .trend-select {
  background: #1c2b1f;
  border-color: #2f4533;
  color: #ffffff;
}

body.dark-mode .search-box input,
body.dark-mode .query-input-wrap input {
  color: #ffffff;
}

body.dark-mode .chip {
  background: #1c2b1f;
  border-color: #2f4533;
  color: #c8e6c9;
}
body.dark-mode .chip.active {
  background: #2e7d32;
  color: #ffffff;
  border-color: #388e3c;
}

body.dark-mode .quick-q-chip {
  background: #192a1c;
  border-color: #2b4530;
  color: #81c784;
}

body.dark-mode .bottom-nav {
  background: #121c14;
  border-top-color: #243527;
}

body.dark-mode .nav-item {
  color: #78909c;
}
body.dark-mode .nav-item.active {
  color: #81c784;
}

body.dark-mode .svg-chart-container {
  background: #121c14;
  border-color: #243527;
}

body.dark-mode .bargain-tip {
  background: #2a2012;
  color: #ffe082;
}

body.dark-mode .diagnosis-card {
  background: #19251c;
  border-color: #29402e;
}

body.dark-mode .diag-block.chemical {
  background: #2c2212;
  color: #ffe082;
  border-left-color: #ffb300;
}

body.dark-mode .diag-block.organic {
  background: #17281a;
  color: #c8e6c9;
  border-left-color: #4caf50;
}

body.dark-mode .calc-result-box {
  background: #262013;
  border-color: #4a3a1f;
}

body.dark-mode .negotiation-script-box {
  background: #1b261d;
  border-color: #3d301b;
  color: #fff8e1;
}
body.dark-mode .negotiation-script-box p {
  color: #ffecb3;
}

body.dark-mode .forecast-day-card {
  background: #18251b;
  border-color: #27392b;
  color: #e8f5e9;
}

body.dark-mode .crop-tag {
  background: #1c2b1f;
  border-color: #2f4533;
  color: #c8e6c9;
}
body.dark-mode .crop-tag.active {
  background: #233e27;
  border-color: #4caf50;
  color: #a5d6a7;
}

body.dark-mode .commodity-card {
  background: #152217;
  border: 1px solid #263c29;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
}

body.dark-mode .item-speaker-btn {
  background: #1e3322;
  border-color: #375b3c;
  color: #4ade80;
  box-shadow: 0 0 8px rgba(74, 222, 128, 0.15);
}

body.dark-mode .item-details h4 {
  color: #ffffff;
  font-weight: 700;
}

body.dark-mode .item-details .item-market {
  color: #9db59f;
  font-size: 11.5px;
}

body.dark-mode .price-type {
  color: #94a3b8;
}

body.dark-mode .price-val.wholesale {
  color: #4ade80;
  font-weight: 800;
}

body.dark-mode .price-val.retail {
  color: #f1f5f9;
  font-weight: 700;
}

body.dark-mode .trend-badge.stable {
  background: #1e293b;
  color: #94a3b8;
  border: 1px solid #334155;
}

body.dark-mode .trend-badge.up {
  background: #3b0d0d;
  color: #fca5a5;
  border: 1px solid #7f1d1d;
}

body.dark-mode .trend-badge.down {
  background: #063118;
  color: #4ade80;
  border: 1px solid #14532d;
}

body.dark-mode .action-steps {
  background: #18281b;
  color: #dcedc8;
}
body.dark-mode .action-steps h5 {
  color: #aed581;
}

body.dark-mode .stats-card {
  background: #19271c;
  color: #c8e6c9;
}

/* Additional High-Contrast Dark Mode Fine-Tuning */
body.dark-mode .summary-title {
  color: #ff8a65 !important;
}

body.dark-mode .advisory-header h3 {
  color: #f87171 !important;
}

body.dark-mode .ai-badge {
  background: #0d2847 !important;
  color: #90caf9 !important;
  border: 1px solid #1565c0;
}

body.dark-mode .voice-btn-mini {
  background: #1b2e1f !important;
  border-color: #388e3c !important;
  color: #81c784 !important;
}

body.dark-mode .action-box.dos-box {
  background: #0e2714 !important;
  border: 1px solid #1c5227 !important;
  color: #dcedc8 !important;
}
body.dark-mode .action-box.dos-box h4 {
  color: #a5d6a7 !important;
}

body.dark-mode .action-box.donts-box {
  background: #2e0d0d !important;
  border: 1px solid #5c1b1b !important;
  color: #ffcdd2 !important;
}
body.dark-mode .action-box.donts-box h4 {
  color: #fca5a5 !important;
}

body.dark-mode .action-box.irrig-box {
  background: #0c2338 !important;
  border: 1px solid #14446e !important;
  color: #e1f5fe !important;
}
body.dark-mode .action-box.irrig-box h4 {
  color: #90caf9 !important;
}

body.dark-mode .forecast-day-card .day-temp {
  color: #4ade80 !important;
}

body.dark-mode .bargain-tip {
  background: #261c10 !important;
  color: #ffe082 !important;
  border-left: 3px solid #ffb300 !important;
}

/* Offline Banner */
.offline-banner {
  background: #fff3e0;
  color: #e65100;
  border: 1px solid #ffe0b2;
  font-size: 12px;
  font-weight: 600;
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 6px;
}
body.dark-mode .offline-banner {
  background: #2b1d0c;
  color: #ffb74d;
  border-color: #5c3814;
}
